{
  "name": "stage-player",
  "version": "0.1.14",
  "description": "演出播放器：音频 / 视频 / PPT / PDF 一体化演出播放",
  "private": true,
  "scripts": {
    "tauri": "tauri",
    "sidecar": "cargo build -p lyric-asr-sidecar --manifest-path src-tauri/Cargo.toml",
    "sidecar:release": "cargo build -p lyric-asr-sidecar --release --manifest-path src-tauri/Cargo.toml",
    "sidecar:stage": "node scripts/stage-sidecar.mjs",
    "dev": "npm run sidecar && tauri dev",
    "build": "npm run sidecar:release && npm run sidecar:stage && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  },
  "dependencies": {
    "pdfjs-dist": "^4.10.38"
  }
}
