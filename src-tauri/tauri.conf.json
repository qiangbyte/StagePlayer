{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "演出播放器",
  "version": "0.1.0",
  "identifier": "com.stageplayer.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StagePlayer 演出播放器",
        "width": 1380,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true,
        "theme": "Dark",
        "backgroundColor": "#1b1b1f"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "resources/models/manifest.json",
      "resources/models/README.txt"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
