{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "演出播放器",
  "version": "0.1.13",
  "identifier": "com.stageplayer.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StagePlayer 演出播放器",
        "width": 1380,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true,
        "devtools": false,
        "theme": "Dark",
        "backgroundColor": "#1b1b1f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; font-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob:; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": [
      "binaries/lyric-asr-sidecar"
    ],
    "resources": [
      "resources/models/manifest.json",
      "resources/models/README.txt",
      "resources/models/asr/README.txt"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
